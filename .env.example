# Every value below is optional. With none of them set, DriftSentinel runs offline:
# replay mode serves fixtures and the judge falls back to its rule-based classifier.

PROBE_MODE=replay          # replay | live
PROBE_INTERVAL=15          # seconds between probe cycles
METRICS_PORT=8000
UI_PORT=8090
LOG_FILE=logs/driftsentinel.log

# Real LLM judgments and verdict narration instead of heuristic-fallback.
# Set ONE of the two blocks. LLM_PROVIDER=auto picks whichever key is present.
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Any OpenAI-compatible endpoint. Examples:
#   OpenAI  OPENAI_API_KEY=sk-...            OPENAI_MODEL=gpt-4o-mini
#   Groq    OPENAI_API_KEY=gsk_...           OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Gemini  OPENAI_API_KEY=AIza...            OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#           OPENAI_MODEL=gemini-2.0-flash
#   Ollama  OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=llama3.1   (no key needed)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Required only for PROBE_MODE=live.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
